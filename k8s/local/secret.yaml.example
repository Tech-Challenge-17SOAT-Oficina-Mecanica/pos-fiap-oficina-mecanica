# Exemplo versionado: nenhum valor aqui e credencial real.
# Copie para k8s/local/secret.yaml (ignorado pelo Git), preencha e aplique.
# A extensao .example evita que `kubectl apply -f k8s/` aplique os marcadores.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-api-secret
  namespace: oficina
type: Opaque
stringData:
  DB_USER: "PREENCHER_USUARIO"
  # Somente exemplo; no fluxo Terraform, as credenciais sao criadas por infra/local/platform.
  DB_PASSWORD: "PREENCHER_SENHA"
  # Mesma chave em todas as replicas; trocar invalida os tokens ja emitidos.
  JWT_SECRET: "PREENCHER_CHAVE_ALEATORIA"
  # Opcionais: vazios desligam o canal correspondente.
  SMTP_SENHA: ""
  RESEND_API_KEY: ""
  # Alternativa as variaveis DB_*: quando preenchida, tem prioridade.
  # DATABASE_URL: "postgres://USUARIO:SENHA@HOST:5432/oficina?sslmode=require"
