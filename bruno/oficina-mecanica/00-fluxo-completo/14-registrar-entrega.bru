meta {
  name: 14 - Registrar entrega (dispara e-mail)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/ordens-servico/{{osId}}/entrega
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "observacoes": "Cliente retirou o veiculo"
  }
}

docs {
  DISPARA E-MAIL: "Confirmacao da entrega do seu veiculo".
}

tests {
  test("entregue", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.status).to.equal("ENTREGUE");
  });
}
