meta {
  name: 04 - Criar OS
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/ordens-servico
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "veiculoId": "{{veiculoId}}",
    "servicos": [
      { "servicoId": "{{servicoId}}" }
    ],
    "pecas": [
      { "pecaId": "{{pecaId}}", "quantidade": 2 }
    ]
  }
}

script:post-response {
  bru.setVar("osId", res.body.ordemServicoId);
}

docs {
  Abre a OS ja com o servico e as pecas solicitados pelo cliente. Eles entram no orcamento
  PRINCIPAL, criado na mesma transacao; o id do orcamento e capturado no passo 06.
}

tests {
  test("OS criada em RECEBIDA", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.status).to.equal("RECEBIDA");
  });
}
