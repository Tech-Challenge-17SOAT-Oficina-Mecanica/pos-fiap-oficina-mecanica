meta {
  name: 06 - Problema encontrado no diagnostico
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/ordens-servico/{{osId}}/problemas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "descricao": "Amortecedor dianteiro gasto",
    "observacoes": "Troca recomendada"
  }
}

script:post-response {
  // O problema entra no orcamento PRINCIPAL aberto no passo 04, com o servico e as pecas.
  if (res.body.orcamento && res.body.orcamento.id) {
    bru.setVar("orcamentoId", res.body.orcamento.id);
  }
}

docs {
  Vincula o problema ao orcamento PRINCIPAL da OS, que ja esta EM_DIAGNOSTICO desde o passo 05.
}

tests {
  test("registrado", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
