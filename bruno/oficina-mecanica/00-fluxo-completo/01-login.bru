meta {
  name: 01 - Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/autenticacao/login
  body: json
}

body:json {
  {
    "email": "{{email}}",
    "senha": "{{senha}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.accessToken);
}

docs {
  Rode a pasta inteira de uma vez (Run Folder) ou uma a uma, na ordem.

  Cada execucao gera cliente, veiculo e OS NOVOS, com documento e placa unicos.
  Por isso da para repetir quantas vezes quiser sem 409 de duplicidade.
}

tests {
  test("autenticou", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
