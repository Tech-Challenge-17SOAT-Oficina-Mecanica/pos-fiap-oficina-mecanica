meta {
  name: POST /ordens-servico
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/ordens-servico
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "veiculoId": "{{veiculoId}}",
    "servicos": [
      { "servicoId": "{{servicoId}}", "observacao": "Solicitado pelo cliente na recepcao" }
    ],
    "pecas": [
      { "pecaId": "{{pecaId}}", "quantidade": 1 }
    ]
  }
}

docs {
  Escopo exigido: os:escrever

  Rode 00-auth/Login antes para preencher o token.

  servicos e pecas sao opcionais. Quando informados, entram no orcamento PRINCIPAL da OS,
  criado na mesma transacao: um servico ou peca invalido desfaz a abertura inteira.
}
