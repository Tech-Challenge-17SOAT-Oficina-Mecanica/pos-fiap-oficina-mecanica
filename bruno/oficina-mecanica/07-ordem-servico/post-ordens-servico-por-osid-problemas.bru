meta {
  name: POST /ordens-servico/{osId}/problemas
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/ordens-servico/{{osId}}/problemas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "descricao": "Ruido na suspensao dianteira",
    "observacoes": "Percebido em lombadas"
  }
}

docs {
  Escopo exigido: os:escrever

  Rode 00-auth/Login antes para preencher o token.
}
