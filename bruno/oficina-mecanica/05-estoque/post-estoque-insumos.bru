meta {
  name: POST /estoque/insumos
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/estoque/insumos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nome": "Nome de exemplo",
    "descricao": "Descricao de exemplo",
    "categoriaId": "{{categoriaId}}",
    "fornecedorId": "{{fornecedorId}}",
    "unidadeMedida": "UN",
    "custoUnitario": 10.0,
    "estoqueMinimo": 0
  }
}

docs {
  Escopo exigido: estoque:escrever

  Rode 00-auth/Login antes para preencher o token.
}
