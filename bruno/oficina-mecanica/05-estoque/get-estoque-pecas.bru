meta {
  name: GET /estoque/pecas
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/estoque/pecas?descricao=filtro
  auth: bearer
}
params:query {
  descricao: filtro
  ~codigo: PEC-000001
  ~categoriaId: 
  ~fabricante: 
  ~quantidadeDesejada: 1
  ~somenteDisponiveis: false
  ~incluirInativos: false
  ~pagina: 0
  ~tamanho: 20
}

auth:bearer {
  token: {{token}}
}

docs {
  Informe ao menos codigo OU descricao, senao responde 400.
  Booleanos aceitam apenas true ou false. tamanho vai de 1 a 50.

  Escopo exigido: estoque:ler

  Rode 00-auth/Login antes para preencher o token.
}
