meta {
  name: POST /estoque/solicitacoes-compra-reserva
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/estoque/solicitacoes-compra-reserva
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "ordemServicoId": "{{osId}}",
    "fornecedorId": "{{fornecedorId}}",
    "itens": [
      {
        "itemId": "{{clienteId}}",
        "quantidade": 1
      }
    ]
  }
}

docs {
  Escopo exigido: estoque:movimentar

  Rode 00-auth/Login antes para preencher o token.
}
