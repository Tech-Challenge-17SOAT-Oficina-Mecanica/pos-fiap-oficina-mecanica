# Copie para .env e ajuste. Nenhum valor real deve ser commitado.

# --- Banco e autenticacao -------------------------------------------------
DB_NAME=oficina
DB_USER=oficina
DB_PASSWORD=oficina
JWT_SECRET=segredo-local

# --- Qualidade ------------------------------------------------------------
SONAR_PROJECT_KEY=oficina-mecanica
SONAR_TOKEN=cole-seu-token-local-aqui

# --- Notificacoes ---------------------------------------------------------
# Sem nada configurado, as notificacoes so vao para o log da aplicacao.

# Mailpit (padrao do docker-compose): captura os e-mails localmente,
# visiveis em http://localhost:8025. Nada sai para a internet.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=

# Resend: envio real. Tem prioridade sobre o SMTP quando preenchida.
# Em modo de teste o Resend so entrega para o e-mail dono da conta.
RESEND_API_KEY=

# Remetente usado pelos dois canais.
# onboarding@resend.dev e o remetente de teste do Resend e funciona sem verificar
# dominio. Para enviar a qualquer destinatario, verifique um dominio proprio em
# resend.com/domains e use um endereco dele aqui.
EMAIL_REMETENTE=Oficina Mecanica <onboarding@resend.dev>

# Cadencia do processamento da fila.
NOTIFICACAO_INTERVALO_SEGUNDOS=30
NOTIFICACAO_LOTE=20

# --- Orcamento ------------------------------------------------------------
# Quantas OS a oficina atende por dia. Vazio ou zero deixa a fila fora da
# estimativa de entrega em vez de impedir o calculo.
CAPACIDADE_DIARIA_OS=
